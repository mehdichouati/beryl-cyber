# Configuration de Beryl CYBER
# Copier ce fichier en beryl-cyber.conf et l'adapter.

# Emplacement des données sur la clé USB
DATA_DIR=/mnt/beryl/beryl-cyber/data
LOG_DIR=/mnt/beryl/beryl-cyber/logs
BACKUP_DIR=/mnt/beryl/beryl-cyber/backup

# Intervalle de collecte (secondes)
COLLECT_INTERVAL=60

# Délai sans réponse avant de considérer un appareil hors ligne (secondes)
OFFLINE_AFTER=300

# Poste d'administration : seul cet appareil peut ouvrir le tableau de bord.
# Laisser vide pour ne pas restreindre l'accès (déconseillé).
ADMIN_MAC=
ADMIN_IP=

# Port du tableau de bord
WEB_PORT=8080

# Liste blanche : 1 = seuls le poste d'administration et les appareils approuvés
# ont accès à Internet. 0 = seuls les appareils bloqués sont coupés.
# Approuver ses propres appareils AVANT de passer à 1.
WHITELIST_ENABLED=0

# Notifications Discord (laisser vide pour désactiver)
# DISCORD_TOKEN      : jeton du bot (secret : ne jamais le publier)
# DISCORD_CHANNEL_ID : identifiant du salon privé des alertes
# DISCORD_ADMIN_ID   : ton identifiant Discord (seules tes réactions sont prises en compte)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ID=
