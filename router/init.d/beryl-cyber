#!/bin/sh /etc/rc.common
# Beryl CYBER : service procd (démarrage automatique et redémarrage en cas d'arrêt)
#
# Deux instances :
#   collect : collecte des appareils en boucle
#   web     : tableau de bord, servi par un uhttpd dédié sur le port 8080,
#             indépendant du serveur web de l'interface GL.iNet (nginx)

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/beryl-cyber-launch
WEB_ROOT=/mnt/beryl/beryl-cyber/app/web
WEB_PORT=8080

start_service() {
    # Adresse LAN du routeur : le tableau de bord n'écoute que côté réseau local
    lan_ip="$(uci -q get network.lan.ipaddr | cut -d/ -f1)"
    [ -n "$lan_ip" ] || lan_ip="192.168.8.1"

    procd_open_instance collect
    procd_set_param command "$PROG"
    # relance automatique : fenêtre 3600 s, 10 s d'attente, tentatives illimitées
    procd_set_param respawn 3600 10 0
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance web
    procd_set_param command /usr/sbin/uhttpd -f \
        -h "$WEB_ROOT" \
        -x /cgi-bin \
        -p "$lan_ip:$WEB_PORT" \
        -t 30 -T 30
    procd_set_param respawn 3600 10 0
    procd_set_param stderr 1
    procd_close_instance
}
